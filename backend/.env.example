# Server
PORT=5000
NODE_ENV=development

# MongoDB
MONGODB_URI=mongodb://localhost:27017/livestock_chatbot

# NVIDIA AI (NIM API)
NVIDIA_API_KEY=your_nvidia_api_key_here
NVIDIA_BASE_URL=https://integrate.api.nvidia.com/v1
NVIDIA_MODEL=meta/llama-3.1-70b-instruct

# Speech Services (Web Speech API or external)
# Optional: Azure Speech / Google Speech / Deepgram
SPEECH_API_KEY=your_speech_key_here

# Local Python Speech Models Config (Optional)
# Set to 'venv/bin/python' if running in a virtual environment
PYTHON_PATH=python3
# Whisper model sizes: tiny, base, small, medium, large-v3 (default is base)
WHISPER_MODEL=base

# CORS
ALLOWED_ORIGINS=http://localhost:3000,http://localhost:5173

# Rate Limiting
RATE_LIMIT_WINDOW_MS=900000
RATE_LIMIT_MAX=100
